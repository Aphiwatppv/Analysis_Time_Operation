#!/usr/bin/env python3

import os
import shutil
import sys


def move_folders_by_keywords(
    source_dir: str,
    dest_dir: str,
    keywords: list,
    case_insensitive: bool = True
):
    source_dir = os.path.abspath(source_dir)
    dest_dir = os.path.abspath(dest_dir)

    if not os.path.isdir(source_dir):
        print(f"[ERROR] Source directory not found: {source_dir}")
        sys.exit(1)

    os.makedirs(dest_dir, exist_ok=True)

    keywords_cmp = [k.lower() for k in keywords] if case_insensitive else keywords
    matched_dirs = []

    # Only top-level directories (Linux-safe)
    for entry in os.scandir(source_dir):
        if not entry.is_dir(follow_symlinks=False):
            continue

        name_cmp = entry.name.lower() if case_insensitive else entry.name
        if any(k in name_cmp for k in keywords_cmp):
            matched_dirs.append(entry.path)

    if not matched_dirs:
        print("[INFO] No matching folders found.")
        return

    print("\nFolders that will be moved:")
    for d in matched_dirs:
        print(f"  - {d}")

    confirm = input("\nProceed? (y/n): ").strip().lower()
    if confirm != "y":
        print("Cancelled.")
        return

    for folder in matched_dirs:
        dest_path = os.path.join(dest_dir, os.path.basename(folder))

        if os.path.exists(dest_path):
            print(f"[SKIP] Destination exists: {dest_path}")
            continue

        shutil.move(folder, dest_path)
        print(f"[OK] {folder} -> {dest_path}")

    print("\nDone.")


if __name__ == "__main__":
    if len(sys.argv) < 4:
        print("Usage:")
        print("  python3 move_folders_linux.py <source_dir> <dest_dir> <keyword1,keyword2,...>")
        sys.exit(1)

    source = sys.argv[1]
    dest = sys.argv[2]
    keywords = [k.strip() for k in sys.argv[3].split(",") if k.strip()]

    move_folders_by_keywords(source, dest, keywords)
