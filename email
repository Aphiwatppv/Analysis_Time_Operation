#!/usr/bin/env python3

import os
import tarfile
import shutil

def main():
    print("=== Extract .tar.gz and Move Result ===\n")

    source_dir = input("Enter SOURCE directory (contains .tar.gz): ").strip()
    dest_dir   = input("Enter DESTINATION directory: ").strip()

    if not os.path.isdir(source_dir):
        print("❌ Source directory does not exist")
        return

    os.makedirs(dest_dir, exist_ok=True)

    # Find .tar.gz files
    tar_files = [
        f for f in os.listdir(source_dir)
        if f.endswith(".tar.gz") and os.path.isfile(os.path.join(source_dir, f))
    ]

    if not tar_files:
        print("⚠️ No .tar.gz files found.")
        return

    # ===== Summary =====
    print("\n========== SUMMARY ==========")
    print(f"Source directory : {source_dir}")
    print(f"Destination      : {dest_dir}")
    print(f"Archives found   : {len(tar_files)}")
    print("============================\n")

    for f in tar_files:
        print(f" - {f}")

    confirm = input("\nProceed with extraction and move? (y/n): ").strip().lower()
    if confirm != "y":
        print("❌ Operation cancelled.")
        return

    print("\n🚀 Processing archives...\n")

    for tar_name in tar_files:
        tar_path = os.path.join(source_dir, tar_name)
        extract_folder = os.path.join(source_dir, tar_name.replace(".tar.gz", ""))

        print(f"📦 Extracting: {tar_name}")

        # Extract
        with tarfile.open(tar_path, "r:gz") as tar:
            tar.extractall(path=extract_folder)

        # Move extracted content
        for item in os.listdir(extract_folder):
            src_path = os.path.join(extract_folder, item)
            dest_path = os.path.join(dest_dir, item)

            if os.path.exists(dest_path):
                print(f"⚠️ Skipped (exists): {dest_path}")
                continue

            shutil.move(src_path, dest_path)
            print(f"Moved: {item}")

        # Cleanup extraction folder
        shutil.rmtree(extract_folder)
        print(f"🧹 Cleaned temp folder: {extract_folder}\n")

    print("✅ All archives processed successfully.")

if __name__ == "__main__":
    main()

