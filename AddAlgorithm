lot_ids = ['ZA523125', 'ZA518397', 'ZA525223']

# --- Build Oracle-friendly bind placeholders for IN (...) ---
placeholders = ",".join([f":lot{i}" for i in range(len(lot_ids))])
params = {f"lot{i}": v for i, v in enumerate(lot_ids)}

SqlScript = f"""
