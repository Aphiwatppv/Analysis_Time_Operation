import os
import shutil

def move_folders_by_keywords(
    source_dir: str,
    dest_dir: str,
    keywords: list[str],
    case_insensitive: bool = True
):
    if not os.path.isdir(source_dir):
        print(f"❌ Source directory not found: {source_dir}")
        return

    os.makedirs(dest_dir, exist_ok=True)

    keywords_cmp = [k.lower() for k in keywords] if case_insensitive else keywords
    matched_dirs = []

    for name in os.listdir(source_dir):
        full_path = os.path.join(source_dir, name)

        if not os.path.isdir(full_path):
            continue

        name_cmp = name.lower() if case_insensitive else name

        if any(k in name_cmp for k in keywords_cmp):
            matched_dirs.append(full_path)

    if not matched_dirs:
        print("⚠️ No matching folders found.")
        return

    # Preview
    print("\n📂 Folders to be moved:")
    for d in matched_dirs:
        print("  -", d)

    confirm = input("\nProceed with moving? (y/n): ").strip().lower()
    if confirm != "y":
        print("❌ Operation cancelled.")
        return

    # Move
    for folder in matched_dirs:
        dest_path = os.path.join(dest_dir, os.path.basename(folder))
        shutil.move(folder, dest_path)
        print(f"✅ Moved: {folder} → {dest_path}")

    print("\n🎉 Done.")


if __name__ == "__main__":
    source = input("Source directory: ").strip()
    dest = input("Destination directory: ").strip()
    keywords = input("Keywords (comma-separated): ").split(",")

    keywords = [k.strip() for k in keywords if k.strip()]

    move_folders_by_keywords(source, dest, keywords)
